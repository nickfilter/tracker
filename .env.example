# ═══════════════════════════════════════════════════════════
#  ClickDealer 联盟归因系统 · 环境变量示例
#  复制为 .env 后填入真实值；Render 部署时在面板里逐项配置
# ═══════════════════════════════════════════════════════════

# ───── 数据库 ─────
# Render Blueprint 会自动把 Postgres 的 Internal URL 注入到这里
DATABASE_URL=postgres://user:password@host:5432/clickdealer

# 不用 DATABASE_URL 时可改用拆分变量（按需保留其一）
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=yourpassword
# DB_NAME=clickdealer
# DB_SSL=0                          # Render 内网连接不需要 SSL

# ───── 服务 ─────
PORT=3000
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please     # ⚠️ 必填，后台登录密码
SESSION_SECRET=dev-secret-change-me # Render 用 generateValue 自动生成
COOKIE_SECURE=1                     # 生产 HTTPS 设 1；本地 http 调试必须设 0

# ───── 站点信息（落地页/法务页展示）─────
BASE_URL=https://your-app.onrender.com
SITE_NAME=My Offers
COMPANY_NAME=My Company Ltd
CONTACT_EMAIL=contact@example.com
COMPANY_ADDRESS=123 Demo Street

# ───── Facebook CAPI ─────
FB_ENABLED=0                        # 1 开启，0 关闭
FB_PIXEL_ID=
FB_ACCESS_TOKEN=                    # Events Manager 生成的长期 token
FB_API_VERSION=v19.0                # 留空默认 v19.0
FB_TEST_EVENT_CODE=                 # 仅调试时填（Test Events 面板获取）

# ───── Google Ads 增强转化 ─────
GOOGLE_ENABLED=0                    # 1 开启，0 关闭
GOOGLE_CUSTOMER_ID=                 # 客户 ID，纯数字（不带横线）
GOOGLE_CONVERSION_ACTION_ID=        # 转化动作 ID
GOOGLE_DEVELOPER_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_ENHANCED_CONVERSIONS=1       # 1 时带上哈希邮箱/电话（提升匹配度）
GA_TAG_ID=                          # GA4 衡量 ID，如 G-XXXXXXX
